# Copy to .env (next to docker-compose.yml) and fill in.
# After editing, apply with:  docker compose up -d

# Where Hermes's API server listens, as seen from inside the container.
#   Hermes on this same machine:       http://host.docker.internal:8642
#   Hermes on another VM / LXC:        http://192.168.1.50:8642
HERMES_URL=http://host.docker.internal:8642

# The API server key. The server adds it to every request to Hermes; it is
# never sent to the browser or stored in the page.
HERMES_API_KEY=

# Optional: force the model name sent to Hermes (leave empty to use the
# page's Settings value, "hermes-agent" by default).
HERMES_MODEL=
